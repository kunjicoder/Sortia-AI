# Copy this file to .env and fill in your keys.
# Never commit .env — it is gitignored.

# --- LLM ---
# xAI Grok (primary). Used via openai SDK with base_url override.
GROK_API_KEY=

# Google Gemini (fallback). Free tier is fine.
GEMINI_API_KEY=

# AI/ML API (partner prize). OpenAI-compatible unified gateway.
# Claim coupon: https://lablab.ai/redeem-coupon/ai-ml-api-coupon-brightdata-hackathon
AIML_API_KEY=
AIML_MODEL=gpt-4o-mini

# Synthesis provider: "aiml" (partner, default) or "grok".
LLM_PROVIDER=aiml

# --- Bright Data ---
# API token from https://brightdata.com (promo: unlocked for $250 credit)
BRIGHTDATA_API_KEY=

# Zone names — created in the Bright Data dashboard per product
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SCRAPER_ZONE=

# Scraping Browser CDP endpoint (V2 — two-product demo)
# Format: wss://brd-customer-hl_XXXXXXXX-zone-scraping_browser:PASSWORD@brd.superproxy.io:9222
# Get from: Bright Data dashboard → Scraping Browser zone → Connection settings
BRIGHTDATA_BROWSER_URL=

# Web Scraper API — LinkedIn COMPANY collector dataset id (V3 — three-product demo)
# The differentiation layer: structured LinkedIn signals no LLM tool can reach.
# Get the dataset id from: Bright Data dashboard → Web Scraper API → LinkedIn company info.
# Confirm the exact id before running — collector ids look like gd_xxxxxxxxxxxxxxxx.
BRIGHTDATA_DATASET_COMPANY=

# Web Scraper API — LinkedIn PEOPLE collector dataset id (V4 — founder pedigree)
# Unlocks: university, prior companies, prior exits/scaling per founder.
# Get the dataset id from: Bright Data dashboard → Web Scraper API → LinkedIn person profile.
BRIGHTDATA_DATASET_PEOPLE=

# --- App ---
# Set to "true" to use cached responses for demo targets when live calls fail
USE_DEMO_CACHE=false
# DEEP=true enables heavy founder-pedigree collectors (LinkedIn People).
# Adds ~30-60s; off by default to keep the live path under 90s.
DEEP=false
LOG_LEVEL=INFO
