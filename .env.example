# Copy this file to .env and fill in your keys.
# Never commit .env — it is gitignored.

# --- LLM ---
# xAI Grok (primary). Used via openai SDK with base_url override.
GROK_API_KEY=

# Google Gemini (fallback). Free tier is fine.
GEMINI_API_KEY=

# --- Bright Data ---
# API token from https://brightdata.com (promo: unlocked for $250 credit)
BRIGHTDATA_API_KEY=

# Zone names — created in the Bright Data dashboard per product
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SCRAPER_ZONE=

# --- App ---
# Set to "true" to use cached responses for demo targets when live calls fail
USE_DEMO_CACHE=false
LOG_LEVEL=INFO
